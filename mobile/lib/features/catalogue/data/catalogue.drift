-- Local catalogue: the schema of the catalogue snapshot built by the backend
-- (backend/app/Modules/Catalogue/Snapshot/SnapshotWriter.php, schema version 1).
-- The app never creates or writes these tables; it opens the snapshot file
-- read-only. Keep this file identical to the snapshot schema; a test compares
-- them against a snapshot built by the backend.

CREATE TABLE meta (
  "key" TEXT PRIMARY KEY NOT NULL,
  value TEXT NOT NULL
) AS CatalogueMetaEntry;

CREATE TABLE categories (
  id TEXT PRIMARY KEY NOT NULL,
  code TEXT NOT NULL UNIQUE,
  name_el TEXT NOT NULL,
  name_en TEXT NOT NULL,
  parent_id TEXT,
  sort_order INTEGER
) AS CatalogueCategory;

CREATE TABLE climate_zones (
  id TEXT PRIMARY KEY NOT NULL,
  code TEXT NOT NULL UNIQUE,
  name_el TEXT NOT NULL,
  name_en TEXT NOT NULL,
  description TEXT,
  rules TEXT NOT NULL
) AS CatalogueClimateZone;

CREATE TABLE plants (
  id TEXT PRIMARY KEY NOT NULL,
  scientific_name TEXT NOT NULL UNIQUE,
  gbif_id INTEGER,
  category_id TEXT NOT NULL,
  temp_min_c REAL,
  temp_opt_c REAL,
  temp_max_c REAL,
  water_need INTEGER,
  sun TEXT,
  soil_types TEXT,
  ph_min REAL,
  ph_max REAL,
  frost_hardiness TEXT,
  propagation TEXT,
  sow_depth_cm REAL,
  spacing_cm INTEGER,
  row_spacing_cm INTEGER,
  days_to_harvest INTEGER,
  published_at TEXT,
  updated_at TEXT,
  search_keys TEXT NOT NULL
) AS CataloguePlant;

CREATE INDEX plants_category_id ON plants (category_id);

CREATE TABLE plant_translations (
  id TEXT PRIMARY KEY NOT NULL,
  plant_id TEXT NOT NULL,
  lang TEXT NOT NULL,
  name TEXT NOT NULL,
  description TEXT,
  planting TEXT,
  care TEXT,
  seed_saving TEXT,
  tips TEXT,
  UNIQUE (plant_id, lang)
) AS CataloguePlantTranslation;

CREATE TABLE plant_aliases (
  id TEXT PRIMARY KEY NOT NULL,
  plant_id TEXT NOT NULL,
  lang TEXT,
  alias TEXT NOT NULL,
  kind TEXT
) AS CataloguePlantAlias;

CREATE INDEX plant_aliases_plant_id ON plant_aliases (plant_id);

CREATE TABLE plant_calendars (
  id TEXT PRIMARY KEY NOT NULL,
  plant_id TEXT NOT NULL,
  climate_zone_id TEXT NOT NULL,
  activity TEXT NOT NULL,
  month_from INTEGER NOT NULL,
  month_to INTEGER NOT NULL
) AS CataloguePlantCalendar;

CREATE INDEX plant_calendars_zone ON plant_calendars (climate_zone_id, activity);
CREATE INDEX plant_calendars_plant_id ON plant_calendars (plant_id);

CREATE TABLE companions (
  id TEXT PRIMARY KEY NOT NULL,
  plant_id TEXT NOT NULL,
  other_plant_id TEXT NOT NULL,
  relation TEXT NOT NULL
) AS CatalogueCompanion;

CREATE INDEX companions_plant_id ON companions (plant_id);

CREATE TABLE care_intervals (
  id TEXT PRIMARY KEY NOT NULL,
  plant_id TEXT NOT NULL,
  "action" TEXT NOT NULL,
  interval_days INTEGER NOT NULL,
  month_from INTEGER,
  month_to INTEGER
) AS CatalogueCareInterval;

CREATE INDEX care_intervals_plant_id ON care_intervals (plant_id);

CREATE TABLE plant_photos (
  id TEXT PRIMARY KEY NOT NULL,
  plant_id TEXT NOT NULL,
  credit TEXT NOT NULL,
  licence TEXT NOT NULL,
  source_url TEXT
) AS CataloguePlantPhoto;

CREATE INDEX plant_photos_plant_id ON plant_photos (plant_id);

CREATE TABLE fact_sources (
  id TEXT PRIMARY KEY NOT NULL,
  plant_id TEXT NOT NULL,
  field TEXT NOT NULL,
  source_name TEXT NOT NULL,
  source_url TEXT,
  licence TEXT NOT NULL,
  imported_at TEXT
) AS CatalogueFactSource;

CREATE INDEX fact_sources_plant_id ON fact_sources (plant_id);

CREATE TABLE tips (
  id TEXT PRIMARY KEY NOT NULL,
  text_el TEXT NOT NULL,
  text_en TEXT NOT NULL,
  month_from INTEGER,
  month_to INTEGER,
  climate_zone_id TEXT,
  plant_id TEXT
) AS CatalogueTip;

CREATE TABLE settlements (
  id TEXT PRIMARY KEY NOT NULL,
  name_el TEXT NOT NULL,
  name_en TEXT,
  region TEXT,
  lat REAL NOT NULL,
  lon REAL NOT NULL,
  search_keys TEXT NOT NULL
) AS CatalogueSettlement;

CREATE VIRTUAL TABLE plant_search USING fts5(
  plant_id UNINDEXED,
  search_keys,
  tokenize = 'unicode61 remove_diacritics 2'
);

CREATE VIRTUAL TABLE settlement_search USING fts5(
  settlement_id UNINDEXED,
  search_keys,
  tokenize = 'unicode61 remove_diacritics 2'
);
